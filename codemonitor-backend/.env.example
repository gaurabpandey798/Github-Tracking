# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/ideax_codemonitor?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# GitHub Integration
GITHUB_TOKEN=your_fine_grained_pat_here
GITHUB_ORGANIZATION=MBMC-IdeaX
GITHUB_API_URL=https://api.github.com
GITHUB_API_VERSION=2022-11-28
GITHUB_WEBHOOK_SECRET=your_webhook_hmac_secret_here

# Admin API Security
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_secure_admin_password

# Server
PORT=8085
SPRING_PROFILES_ACTIVE=local

# Monitoring Rule Thresholds
MONITORING_LARGE_COMMIT_FILES=100
MONITORING_LARGE_COMMIT_LINES=5000
MONITORING_SUDDEN_COMMITS=10
MONITORING_SUDDEN_WINDOW_MINUTES=15
MONITORING_BULK_FILES_FACTOR=3.0
